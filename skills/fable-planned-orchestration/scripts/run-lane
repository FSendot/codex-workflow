#!/bin/sh
set -eu

usage() {
    printf '%s\n' \
        "Usage: run-lane <lane> --workspace <repository> [--prompt-file <file>]" \
        "" \
        "Lanes:" \
        "  preflight       Check required CLIs without running an agent" \
        "  fable-plan     Plan the orchestration with Fable" \
        "  luna-read      Run fast broad exploration with Codex Luna" \
        "  terra-read     Run deeper research with Codex Terra" \
        "  opus-write     Implement with Claude Opus" \
        "  opus-correct   Correct findings with Claude Opus" \
        "  opus-review    Run a narrow intermediate review with Claude Opus" \
        "  codex-review   Run the Codex review fallback" \
        "  fable-final    Review the complete diff with Fable"
}

die() {
    printf 'run-lane: %s\n' "$*" >&2
    exit 2
}

canonical_dir() {
    CDPATH= cd -- "$1" 2>/dev/null && pwd -P
}

canonical_file() {
    file_dir=$(dirname -- "$1")
    file_name=$(basename -- "$1")
    canonical_file_dir=$(canonical_dir "$file_dir") || return 1
    printf '%s/%s\n' "$canonical_file_dir" "$file_name"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

print_command() {
    printf 'cwd=%s\n' "$workspace"
    for token do
        printf 'argv=%s\n' "$token"
    done
}

[ "$#" -ge 1 ] || {
    usage >&2
    exit 2
}

lane=$1
shift
workspace_arg=
prompt_arg=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --workspace)
            [ "$#" -ge 2 ] || die "missing value for --workspace"
            [ -z "$workspace_arg" ] || die "--workspace may be supplied only once"
            workspace_arg=$2
            shift 2
            ;;
        --prompt-file)
            [ "$#" -ge 2 ] || die "missing value for --prompt-file"
            [ -z "$prompt_arg" ] || die "--prompt-file may be supplied only once"
            prompt_arg=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unsupported argument: $1"
            ;;
    esac
done

[ -n "$workspace_arg" ] || die "--workspace is required"
workspace=$(canonical_dir "$workspace_arg") || die "workspace is not a readable directory: $workspace_arg"
git_root=$(git -C "$workspace" rev-parse --show-toplevel 2>/dev/null) ||
    die "workspace is not inside a Git repository: $workspace"
git_root=$(canonical_dir "$git_root") || die "cannot canonicalize Git root: $git_root"
[ "$workspace" = "$git_root" ] || die "workspace must be the repository root: $git_root"
git_prompt_path=$(git -C "$workspace" rev-parse --git-path codex-fable-prompts 2>/dev/null) ||
    die "cannot resolve Git prompt directory for workspace: $workspace"
case "$git_prompt_path" in
    /*) ;;
    *) git_prompt_path=$workspace/$git_prompt_path ;;
esac

case "$lane" in
    preflight)
        [ -z "$prompt_arg" ] || die "preflight does not accept --prompt-file"
        require_command claude
        require_command codex
        claude --version
        codex --version
        exit 0
        ;;
    fable-plan|luna-read|terra-read|opus-write|opus-correct|opus-review|codex-review|fable-final)
        ;;
    *)
        die "unknown lane: $lane"
        ;;
esac

[ -n "$prompt_arg" ] || die "--prompt-file is required for lane $lane"
[ -f "$prompt_arg" ] || die "prompt is not a regular file: $prompt_arg"
[ ! -L "$prompt_arg" ] || die "prompt file may not be a symbolic link: $prompt_arg"
prompt_file=$(canonical_file "$prompt_arg") || die "cannot canonicalize prompt file: $prompt_arg"
git_prompt_dir=$(canonical_dir "$git_prompt_path") ||
    die "Git prompt directory does not exist: $git_prompt_path"
case "$prompt_file" in
    "$git_prompt_dir"/*) ;;
    *) die "prompt file must be inside the Git prompt directory: $git_prompt_dir" ;;
esac
prompt=$(sed -n '1,$p' "$prompt_file")
[ -n "$prompt" ] || die "prompt file is empty: $prompt_file"
no_agent_clis="Bash(claude *),Bash(codex *)"
no_nesting="Agent,$no_agent_clis"

case "$lane" in
    fable-final)
        prompt="$prompt

Work directly in this read-only final review lane. You may use the Agent tool to launch bounded read-only subagents for independent review coverage. Tell every subagent not to launch further agents or agent CLIs. Do not invoke claude or codex through Bash. Use the repository's applicable instructions, skills, and scripts."
        ;;
    *)
        prompt="$prompt

Work directly in this lane. Do not launch subagents, use an Agent or Task tool, or invoke claude or codex through Bash. Use the repository's applicable instructions, skills, and scripts within the ownership and permission boundary stated above."
        ;;
esac

case "$lane" in
    fable-plan)
        require_command claude
        set -- claude -p \
            --model claude-fable-5 \
            --effort high \
            --permission-mode plan \
            --tools Read,Grep,Glob,Skill,Bash \
            --disallowedTools "$no_nesting" \
            --no-session-persistence \
            --output-format json \
            "$prompt"
        ;;
    fable-final)
        require_command claude
        set -- claude -p \
            --model claude-fable-5 \
            --effort high \
            --permission-mode plan \
            --tools Read,Grep,Glob,Skill,Bash,Agent \
            --disallowedTools "$no_agent_clis" \
            --no-session-persistence \
            --output-format stream-json \
            --include-partial-messages \
            --verbose \
            "$prompt"
        ;;
    luna-read)
        require_command codex
        set -- codex -a never exec \
            -m gpt-5.6-luna \
            -s read-only \
            --ephemeral \
            -C "$workspace" \
            "$prompt"
        ;;
    terra-read)
        require_command codex
        set -- codex -a never exec \
            -m gpt-5.6-terra \
            -s read-only \
            --ephemeral \
            -C "$workspace" \
            "$prompt"
        ;;
    opus-write|opus-correct)
        require_command claude
        opus_tools="Read,Grep,Glob,Skill,Edit,Write,Bash"
        set -- claude -p \
            --model claude-opus-5 \
            --effort high \
            --permission-mode dontAsk \
            --tools "$opus_tools" \
            --allowedTools "$opus_tools" \
            --disallowedTools "$no_nesting" \
            --no-session-persistence \
            --output-format json \
            "$prompt"
        ;;
    opus-review)
        require_command claude
        set -- claude -p \
            --model claude-opus-5 \
            --effort high \
            --permission-mode plan \
            --tools Read,Grep,Glob,Skill,Bash \
            --disallowedTools "$no_nesting" \
            --no-session-persistence \
            --output-format json \
            "$prompt"
        ;;
    codex-review)
        require_command codex
        set -- codex -a never exec \
            -m gpt-5.6-sol \
            -s read-only \
            --ephemeral \
            -C "$workspace" \
            "$prompt"
        ;;
esac

if [ "${FABLE_ORCHESTRATION_DRY_RUN:-}" = 1 ]; then
    print_command "$@"
    exit 0
fi

cd "$workspace"
exec "$@"
